[
  {"note": "oauth2-proxy's callback code and state",
   "in": "10.0.0.1 - id - - [x] host GET / \"/oauth2/callback?code=abc123&state=def456\" HTTP/1.1",
   "out": "10.0.0.1 - id - - [x] host GET / \"/oauth2/callback?code=***&state=***\" HTTP/1.1"},
  {"note": "Forgejo's signed artifact URL",
   "in": "router: completed GET /api/actions/artifact?taskID=7&sig=abcdef&expires=99 for 1.2.3.4:5",
   "out": "router: completed GET /api/actions/artifact?taskID=7&sig=***&expires=99 for 1.2.3.4:5"},
  {"note": "a cloud storage signature in a URL",
   "in": "GET https://b.example/o?X-Amz-Signature=0a1b2c3d&X-Amz-Date=20261126",
   "out": "GET https://b.example/o?X-Amz-Signature=***&X-Amz-Date=20261126"},
  {"note": "a bearer header",
   "in": "Authorization: Bearer abcdefgh12345678",
   "out": "Authorization: Bearer ***"},
  {"note": "a token header in a quoted curl argument",
   "in": "curl -H \"Authorization: token abc123def\" https://x",
   "out": "curl -H \"Authorization: token ***\" https://x"},
  {"note": "a bearer header holding a short JWT",
   "in": "curl -H 'Authorization: Bearer eyJhbGc.eyJzdWI.sig' x",
   "out": "curl -H 'Authorization: Bearer ***' x"},
  {"note": "a bearer token outside a header",
   "in": "sent bearer s3cr3t-value to the API",
   "out": "sent bearer *** to the API"},
  {"note": "basic credentials",
   "in": "proxy said Basic dXNlcjpwYXNzd29yZA== was refused",
   "out": "proxy said Basic *** was refused"},
  {"note": "a JWT on its own",
   "in": "token eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.dozjgNryP4J3jVmNHl0w5N_XgL0n3I9P end",
   "out": "token *** end"},
  {"note": "a JWT of two long parts",
   "in": "cookie eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0 set",
   "out": "cookie *** set"},
  {"note": "a user and password in a URL",
   "in": "cloning https://nelson:hunter2hunter2@forgejo.romaine.life/a/b.git",
   "out": "cloning https://***@forgejo.romaine.life/a/b.git"},
  {"note": "a short password in a URL",
   "in": "git push https://nelson:hunter2@forgejo.romaine.life/x",
   "out": "git push https://***@forgejo.romaine.life/x"},
  {"note": "a GitHub token",
   "in": "got ghp_0123456789abcdefghij0123456789abcdef back",
   "out": "got *** back"},
  {"note": "a shorter GitHub token",
   "in": "echo ghp_abcdefghijklmnopqrstuvwxyz0123",
   "out": "echo ***"},
  {"note": "a fine-grained GitHub token",
   "in": "GH=github_pat_11ABCDEFG0123456789_abcdefghijklmnopqrstuvwxyz done",
   "out": "GH=*** done"},
  {"note": "an OpenBao token",
   "in": "vault login hvs.CAESIJ0123456789abcdefghijklmnop ok",
   "out": "vault login *** ok"},
  {"note": "a --token= flag",
   "in": "x --token=s3cr3tvalue y",
   "out": "x --token=*** y"},
  {"note": "a flag and its value as two arguments",
   "in": "romaine-auth op --client-secret sh-h-h",
   "out": "romaine-auth op --client-secret ***"},
  {"note": "an environment variable",
   "in": "export PASSWORD=opensesame",
   "out": "export PASSWORD=***"},
  {"note": "a Bitwarden CLI session",
   "in": "export BW_SESSION=\"Zm9vYmFyYmF6cXV4MTIzNDU2Nzg5MA==\"",
   "out": "export BW_SESSION=\"***\""},
  {"note": "a JSON field",
   "in": "error: {\"user\": \"nelson\", \"password\": \"hunter2\"}",
   "out": "error: {\"user\": \"nelson\", \"password\": \"***\"}"},
  {"note": "a refresh token as key=value outside a URL",
   "in": "auth: refreshing refresh_token=1//0gAbCd-EfGh grant_type=refresh_token",
   "out": "auth: refreshing refresh_token=*** grant_type=refresh_token"},
  {"note": "access and ID tokens as key=value, the expiry kept",
   "in": "session saved access_token=ya29.a0AfH6SM id_token=abc.def expires_in=3599",
   "out": "session saved access_token=*** id_token=*** expires_in=3599"},
  {"note": "an OAuth token response, its type and expiry kept",
   "in": "token response: {\"access_token\": \"ya29.a0Af\", \"token_type\": \"Bearer\", \"expires_in\": 3599, \"refresh_token\": \"1//0gxyz\", \"id_token\": \"eyJhbGciOiJSUzI1NiJ9.eyJzdWIiOiIxIn0.c2ln\"}",
   "out": "token response: {\"access_token\": \"***\", \"token_type\": \"Bearer\", \"expires_in\": 3599, \"refresh_token\": \"***\", \"id_token\": \"***\"}"},
  {"note": "a JSON client secret",
   "in": "config: {\"client_id\": \"chess-tactics\", \"client_secret\": \"s3cr3t-v4lue\"}",
   "out": "config: {\"client_id\": \"chess-tactics\", \"client_secret\": \"***\"}"},
  {"note": "a token endpoint's form body with a PKCE verifier",
   "in": "POST /token grant_type=authorization_code&code=SplxlOBe&code_verifier=dBjftJeZ4CVP-mB92K27uhbUJU1p1r&client_id=x",
   "out": "POST /token grant_type=authorization_code&code=***&code_verifier=***&client_id=x"},
  {"note": "session and bearer tokens as key: value",
   "in": "session_token: 5f2b9c0e-aa31 bearer_token: q8w7e6r5t4",
   "out": "session_token: *** bearer_token: ***"},
  {"note": "a session token in a URL",
   "in": "GET /callback?session_token=abc123&next=/home 302",
   "out": "GET /callback?session_token=***&next=/home 302"},
  {"note": "camelCase names in a JavaScript object's single quotes",
   "in": "store: { accessToken: 'abc123', refreshToken: 'def456', userId: 7 }",
   "out": "store: { accessToken: '***', refreshToken: '***', userId: 7 }"},
  {"note": "a Python dict",
   "in": "{'refresh_token': 'abc123', 'other_secret': 'x9'}",
   "out": "{'refresh_token': '***', 'other_secret': '***'}"},
  {"note": "a header whose name ends in token",
   "in": "X-Auth-Token: f00dfeed1234",
   "out": "X-Auth-Token: ***"},
  {"note": "an authorization value without a scheme",
   "in": "headers: {\"authorization\": \"abcdef123456\"} authorization=xyz789",
   "out": "headers: {\"authorization\": \"***\"} authorization=***"},
  {"note": "an authorization value in JSON keeps its scheme",
   "in": "headers: {\"Authorization\": \"Bearer abc123def\"}",
   "out": "headers: {\"Authorization\": \"Bearer ***\"}"},
  {"note": "a Cookie header, every cookie in it",
   "in": "curl -H 'Cookie: _oauth2_proxy=abc123; csrf=def456' https://x",
   "out": "curl -H 'Cookie: ***' https://x"},
  {"note": "a Set-Cookie header with its attributes",
   "in": "Set-Cookie: sid=abc123; Path=/; HttpOnly; Secure",
   "out": "Set-Cookie: ***"},
  {"note": "a JSON set-cookie field",
   "in": "{\"set-cookie\": \"sid=abc123; Path=/\", \"status\": 302}",
   "out": "{\"set-cookie\": \"***\", \"status\": 302}"},
  {"note": "counts of tokens are kept",
   "in": "usage: input_tokens=120 output_tokens=45 max_tokens=4096 tokens=3 tokenizer=bpe",
   "out": "usage: input_tokens=120 output_tokens=45 max_tokens=4096 tokens=3 tokenizer=bpe"},
  {"note": "a token name holding only digits is kept",
   "in": "page: {\"page_token\": 2, \"limit\": 50} next_token=0",
   "out": "page: {\"page_token\": 2, \"limit\": 50} next_token=0"},
  {"note": "names that only contain cookie or token are kept",
   "in": "cookie_jar=/tmp/jar cookies=2 token_count=3 client_secret_expires_at=0",
   "out": "cookie_jar=/tmp/jar cookies=2 token_count=3 client_secret_expires_at=0"},
  {"note": "talk about tokens is kept",
   "in": "the refresh token expired; signing in again",
   "out": "the refresh token expired; signing in again"},
  {"note": "a command with no credential is kept",
   "in": "git status && go test ./...",
   "out": "git status && go test ./..."},
  {"note": "an ordinary query string is kept",
   "in": "2026-11-05T21:28:39.823274235Z GET /api/v3/work_packages?pageSize=20&offset=1 200",
   "out": "2026-11-05T21:28:39.823274235Z GET /api/v3/work_packages?pageSize=20&offset=1 200"},
  {"note": "a lease path is kept",
   "in": "expiration: revoked lease: lease_id=auth/jwt/login/h0123",
   "out": "expiration: revoked lease: lease_id=auth/jwt/login/h0123"},
  {"note": "a launcher's own error is kept",
   "in": "Discord didn't start: The system cannot find the file specified.",
   "out": "Discord didn't start: The system cannot find the file specified."}
]
